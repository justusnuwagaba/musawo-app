# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native projects regenerated by `expo prebuild` / EAS Build from app.json —
# not source of truth, and android/ in particular carries multi-GB Gradle
# build output (android/build, android/.gradle, android/app/build) that must
# never enter git history.
/android/
/ios/

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
functions/lib/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# service account keys (used for one-off admin scripts, never commit)
scripts/*serviceAccountKey*.json

# typescript
*.tsbuildinfo
